default_platform(:ios)

platform :ios do
  desc "Build DemoUI and upload it to TestFlight"
  lane :beta do
    bundle_id = ENV.fetch("DEMOUI_BUNDLE_ID")
    team_id = ENV.fetch("DEMOUI_TEAM_ID")

    signing_config = File.expand_path("../config/Signing.local.xcconfig", __dir__)
    File.write(
      signing_config,
      <<~XCCONFIG
        DEMOUI_BUNDLE_ID = #{bundle_id}
        DEMOUI_TEAM_ID = #{team_id}
        PRODUCT_BUNDLE_IDENTIFIER = $(DEMOUI_BUNDLE_ID)
        DEVELOPMENT_TEAM = $(DEMOUI_TEAM_ID)
        CODE_SIGN_STYLE = Automatic
      XCCONFIG
    )

    begin
      sh("xcodegen generate --spec app/project.yml --project app")

      api_key = app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
        is_key_content_base64: true
      )

      build_app(
        project: "app/DemoUI.xcodeproj",
        scheme: "DemoUI",
        configuration: "Release",
        export_method: "app-store",
        xcargs: "DEMOUI_BUNDLE_ID=#{bundle_id} DEMOUI_TEAM_ID=#{team_id}"
      )

      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true
      )
    ensure
      File.delete(signing_config) if File.file?(signing_config)
    end
  end
end
