default_platform(:ios)

platform :ios do
  desc "Build DemoUI and upload it to TestFlight"
  lane :beta do
    bundle_id = ENV.fetch("DEMOUI_BUNDLE_ID")
    team_id = ENV.fetch("DEMOUI_TEAM_ID")

    repo_root = File.expand_path("..", __dir__)
    local_xcconfig = File.join(repo_root, "config/Signing.local.xcconfig")
    created_local_xcconfig = !File.exist?(local_xcconfig)
    if created_local_xcconfig
      File.write(
        local_xcconfig,
        <<~XCCONFIG
          DEMOUI_BUNDLE_ID = #{bundle_id}
          DEMOUI_TEAM_ID = #{team_id}
          PRODUCT_BUNDLE_IDENTIFIER = $(DEMOUI_BUNDLE_ID)
          DEVELOPMENT_TEAM = $(DEMOUI_TEAM_ID)
          CODE_SIGN_STYLE = Automatic
        XCCONFIG
      )
    end

    begin
      Dir.chdir(repo_root) do
        sh("xcodegen generate --spec app/project.yml --project app")
      end

      api_key = app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
        is_key_content_base64: true
      )

      build_app(
        project: File.join(repo_root, "app/DemoUI.xcodeproj"),
        scheme: "DemoUI",
        configuration: "Release",
        export_method: "app-store",
        xcargs: "DEMOUI_BUNDLE_ID=#{bundle_id} DEMOUI_TEAM_ID=#{team_id}"
      )

      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true
      )
    ensure
      File.delete(local_xcconfig) if created_local_xcconfig && File.file?(local_xcconfig)
      project = File.join(repo_root, "app/DemoUI.xcodeproj")
      File.delete(project) if File.file?(project)
    end
  end
end
