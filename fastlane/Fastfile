require "base64"

default_platform(:ios)

platform :ios do
  desc "Build DemoUI and upload it to TestFlight"
  lane :beta do
    bundle_id = ENV.fetch("DEMOUI_BUNDLE_ID")
    team_id = ENV.fetch("DEMOUI_TEAM_ID")

    repo_root = File.expand_path("..", __dir__)
    local_xcconfig = File.join(repo_root, "config/Signing.local.xcconfig")
    created_local_xcconfig = !File.exist?(local_xcconfig)
    if created_local_xcconfig
      File.write(
        local_xcconfig,
        <<~XCCONFIG
          DEMOUI_BUNDLE_ID = #{bundle_id}
          DEMOUI_TEAM_ID = #{team_id}
          DEMOUI_PROFILE_SPECIFIER = DemoUI App Store
          PRODUCT_BUNDLE_IDENTIFIER = $(DEMOUI_BUNDLE_ID)
          DEVELOPMENT_TEAM = $(DEMOUI_TEAM_ID)
        XCCONFIG
      )
    end

    begin
      Dir.chdir(repo_root) do
        sh("xcodegen generate --spec app/project.yml --project app")
      end

      api_key = app_store_connect_api_key(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
        is_key_content_base64: true,
        in_house: false
      )

      next_build = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: bundle_id,
        platform: "ios",
        initial_build_number: 0
      ).to_i + 1

      get_provisioning_profile(
        api_key: api_key,
        app_identifier: bundle_id,
        team_id: team_id,
        platform: "ios",
        provisioning_name: "DemoUI App Store",
        skip_install: false
      )
      profile_name = ENV.fetch(
        "sigh_#{bundle_id}_appstore_profile-name",
        "DemoUI App Store"
      )

      build_app(
        project: File.join(repo_root, "app/DemoUI.xcodeproj"),
        scheme: "DemoUI",
        configuration: "Release",
        export_method: "app-store",
        export_team_id: team_id,
        xcargs: "CURRENT_PROJECT_VERSION=#{next_build} DEMOUI_BUNDLE_ID=#{bundle_id} DEMOUI_TEAM_ID=#{team_id} DEMOUI_PROFILE_SPECIFIER='#{profile_name}'",
        export_options: {
          signingStyle: "manual",
          teamID: team_id,
          provisioningProfiles: {
            bundle_id => profile_name
          }
        }
      )

      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: false,
        skip_submission: true,
        distribute_external: false
      )

      tf_group_names = ENV.fetch("TESTFLIGHT_GROUPS", "Internal")
                          .split(",").map(&:strip).reject(&:empty?)
      require "spaceship"
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
        key_id: ENV.fetch("ASC_KEY_ID"),
        issuer_id: ENV.fetch("ASC_ISSUER_ID"),
        key: Base64.decode64(ENV.fetch("ASC_KEY_P8_BASE64"))
      )
      asc_app = Spaceship::ConnectAPI::App.find(bundle_id)
      build = Spaceship::ConnectAPI::Build.all(
        app_id: asc_app.id,
        version: "1.0",
        build_number: next_build.to_s
      ).first
      UI.user_error!("Uploaded build 1.0(#{next_build}) not found in ASC for distribution") if build.nil?

      all_groups = asc_app.get_beta_groups
      tf_group_names.each do |gname|
        grp = all_groups.find { |g| g.name == gname }
        if grp.nil?
          grp = asc_app.create_beta_group(
            group_name: gname,
            is_internal_group: true,
            has_access_to_all_builds: false,
            public_link_enabled: nil,
            public_link_limit_enabled: nil,
            public_link_limit: nil
          )
        end
        unless grp.fetch_builds.any? { |candidate| candidate.id == build.id }
          build.add_beta_groups(beta_groups: [grp])
        end
        UI.success("Distributed build 1.0(#{next_build}) to beta group '#{gname}'.")
      end
    ensure
      File.delete(local_xcconfig) if created_local_xcconfig && File.file?(local_xcconfig)
      project = File.join(repo_root, "app/DemoUI.xcodeproj")
      File.delete(project) if File.file?(project)
    end
  end
end
